# Copy to .env and fill in. Never commit .env.

# Which settings module to use: config.settings.local | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local

# Required
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgres://intellihire:change-me@localhost:5432/intellihire
FRONTEND_URL=http://localhost:5181

# Common
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5181
LOG_LEVEL=INFO
DB_CONN_MAX_AGE=60
API_DOCS_ENABLED=True

# Number of reverse proxies in front of the API. Throttling uses the client IP:
# 0 = the direct connection (never trust X-Forwarded-For); N = trust the Nth address from the right.
NUM_PROXIES=0
# Optional: comma-separated email domains rejected for company sign-up (empty = allow all)
COMPANY_EMAIL_BLOCKED_DOMAINS=

# File storage (local development)
MEDIA_ROOT=media
PRIVATE_MEDIA_ROOT=private_media

# Email (local uses the console backend; these are for production)
DEFAULT_FROM_EMAIL=IntelliHire <no-reply@localhost>
# console prints mail to the terminal; smtp.EmailBackend sends it for real.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Production only
CSRF_TRUSTED_ORIGINS=
USE_X_FORWARDED_PROTO=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Background tasks. Local development runs them inline, so Redis is not needed there.
# Production: run a worker and beat (see apps/Module5_Foundation/README.md) with a real broker.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# AI services. "fake" returns fixed answers (development and tests only); production needs openai or gemini and its key.
AI_PROVIDER=fake
AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=
# With AI_PROVIDER=gemini, set these to Gemini model names, for example gemini-2.5-flash and gemini-2.5-pro.
AI_CHAT_MODEL=gpt-4o-mini
AI_EVAL_MODEL=gpt-4o

# --- Live voice interview (Gemini Live API) ---
# Needed in production whatever AI_PROVIDER is: the live screening and technical calls always use Gemini.
# Never commit a real key: .gitignore covers .env and .env.* but not this example file.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
LIVE_INTERVIEW_MAX_SECONDS=900
