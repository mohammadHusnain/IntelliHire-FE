# Copy to .env.local for local development. Never commit real values.

# Base URL of the API. "/api" works with the Vite dev proxy (no CORS needed) and with a reverse proxy in production.
# Use an absolute URL (e.g. https://api.example.com/api) only if the API is on another origin; the backend must then allow this site's origin in CORS_ALLOWED_ORIGINS.
VITE_API_URL=/api

# "false" (default): every integrated feature uses the real backend and no demo credentials are built into the app.
# "true": use the old in-browser demo data (also for modules not yet connected). Never enable in production.
VITE_USE_MOCK_API=false

# Where `npm run dev` forwards /api and /media (development only).
DEV_API_TARGET=http://127.0.0.1:8000
